# GEMINI_API_KEY: Required for Gemini AI Spiritual Counsel & Scripture Search
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# NODE_ENV: Set to production for Render.com live deployment
NODE_ENV="production"

# PORT: The port the server listens on (Render automatically supplies this, default: 3000)
PORT="3000"

# APP_URL: The live URL where this applet is hosted (e.g., https://qesis-henok.onrender.com)
APP_URL="http://localhost:3000"

# PRIEST_SECRET_CODE: Secret code required when registering as a Priest / Spiritual Father (default: 777)
PRIEST_SECRET_CODE="777"

# Optional TURN Relay Server for strict 4G/LTE mobile networks where direct P2P STUN is blocked
# Free TURN credentials can be obtained from metered.ca/tools/openrelay or Cloudflare TURN
# TURN_URL="turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:443?transport=tcp"
# TURN_USERNAME=""
# TURN_CREDENTIAL=""

# Optional (ONLY needed on Vercel if frontend is hosted separately from Render backend)
# Set to your Render service URL without a trailing slash, e.g. https://qesis-henok.onrender.com
# VITE_API_URL=""


