{
  "entities": {
    "AbatAdmin": {
      "title": "AbatAdmin",
      "description": "Authorized priest or administrator record granting administrative access in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified email address of the administrator.",
          "minLength": 3,
          "maxLength": 180
        },
        "role": {
          "type": "string",
          "enum": ["admin", "priest"],
          "description": "Administrative role level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin access was granted."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "AbatUser": {
      "title": "AbatUser",
      "description": "Spiritual community member profile including PII isolated strictly to owner and admin.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "description": "Member secular full name.",
          "minLength": 1,
          "maxLength": 120
        },
        "baptismalName": {
          "type": "string",
          "description": "Member baptismal (spiritual) name.",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Member phone number.",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email.",
          "minLength": 3,
          "maxLength": 180
        },
        "role": {
          "type": "string",
          "enum": ["child", "deacon", "priest", "admin"],
          "description": "Member role within the ministry."
        },
        "confessorPriest": {
          "type": "string",
          "description": "Name of the member's confessor priest.",
          "maxLength": 120
        },
        "confessionStage": {
          "type": "string",
          "enum": ["ጀማሪ", "መካከለኛ", "የበረታ/የቆረበ"],
          "description": "Current spiritual confession stage."
        },
        "avatarSeed": {
          "type": "string",
          "description": "Avatar seed or URL identifier.",
          "maxLength": 200
        },
        "spiritualNotes": {
          "type": "string",
          "description": "Optional spiritual guidance notes.",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was last updated."
        }
      },
      "required": [
        "uid",
        "fullName",
        "baptismalName",
        "phone",
        "email",
        "role",
        "confessorPriest",
        "confessionStage",
        "avatarSeed",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbatRoom": {
      "title": "AbatRoom",
      "description": "Live assembly hall or secret confession room metadata synchronized with LiveKit.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Unique identifier matching LiveKit room ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Display title of the meeting room.",
          "minLength": 1,
          "maxLength": 160
        },
        "hostUid": {
          "type": "string",
          "description": "Firebase Auth UID of the room host.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "hostName": {
          "type": "string",
          "description": "Display name of the room host.",
          "minLength": 1,
          "maxLength": 120
        },
        "roomType": {
          "type": "string",
          "enum": ["assembly", "confession", "study"],
          "description": "Category of the live meeting room."
        },
        "status": {
          "type": "string",
          "enum": ["live", "scheduled", "ended"],
          "description": "Current operational state of the room."
        },
        "visibility": {
          "type": "string",
          "enum": ["community", "private"],
          "description": "Whether the room is visible to community members or private."
        },
        "qualityPreset": {
          "type": "string",
          "enum": ["360p", "720p", "1080p"],
          "description": "Default bandwidth-optimized video preset."
        },
        "participantCount": {
          "type": "number",
          "description": "Latest reported active participant count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when room was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when room metadata was last updated."
        }
      },
      "required": [
        "roomId",
        "title",
        "hostUid",
        "hostName",
        "roomType",
        "status",
        "visibility",
        "qualityPreset",
        "participantCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbatSchedule": {
      "title": "AbatSchedule",
      "description": "Spiritual confession appointment or assembly schedule record.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the member who created the schedule.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "childName": {
          "type": "string",
          "description": "Secular name of the member.",
          "minLength": 1,
          "maxLength": 120
        },
        "baptismalName": {
          "type": "string",
          "description": "Baptismal name of the member.",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Contact phone number for the schedule.",
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "Scheduled date string.",
          "minLength": 1,
          "maxLength": 40
        },
        "time": {
          "type": "string",
          "description": "Scheduled time string.",
          "minLength": 1,
          "maxLength": 40
        },
        "scheduleType": {
          "type": "string",
          "enum": ["confession", "assembly", "prayer"],
          "description": "Type of spiritual appointment or schedule."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"],
          "description": "Lifecycle status of the schedule."
        },
        "secretPasscode": {
          "type": "string",
          "description": "Private passcode for confession room access.",
          "maxLength": 24
        },
        "penanceNotes": {
          "type": "string",
          "description": "Optional notes regarding penance or counseling.",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when schedule was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when schedule was last updated."
        }
      },
      "required": [
        "ownerUid",
        "childName",
        "baptismalName",
        "phone",
        "date",
        "time",
        "scheduleType",
        "status",
        "secretPasscode",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbatAnnouncement": {
      "title": "AbatAnnouncement",
      "description": "Ministry announcements published by priests or administrators.",
      "type": "object",
      "properties": {
        "authorUid": {
          "type": "string",
          "description": "Firebase Auth UID of the publishing priest or administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the author.",
          "minLength": 1,
          "maxLength": 120
        },
        "title": {
          "type": "string",
          "description": "Announcement headline.",
          "minLength": 1,
          "maxLength": 160
        },
        "body": {
          "type": "string",
          "description": "Announcement detailed text.",
          "minLength": 1,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": ["general", "assembly", "fasting", "urgent"],
          "description": "Category tag for the announcement."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "archived"],
          "description": "Whether the announcement is visible to verified members."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when announcement was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when announcement was last updated."
        }
      },
      "required": [
        "authorUid",
        "authorName",
        "title",
        "body",
        "category",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "AbatMessage": {
      "title": "AbatMessage",
      "description": "Text chat message inside a live assembly or confession room.",
      "type": "object",
      "properties": {
        "roomId": {
          "type": "string",
          "description": "Target room identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "description": "Firebase Auth UID of the message author.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "description": "Display name of the sender.",
          "minLength": 1,
          "maxLength": 120
        },
        "isPriest": {
          "type": "boolean",
          "description": "Indicates if sender was a priest or admin."
        },
        "text": {
          "type": "string",
          "description": "Message body text.",
          "minLength": 1,
          "maxLength": 1000
        },
        "timeLabel": {
          "type": "string",
          "description": "Formatted display timestamp string.",
          "minLength": 1,
          "maxLength": 32
        },
        "visibility": {
          "type": "string",
          "enum": ["room", "deleted"],
          "description": "Message visibility state inside the room."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when message was sent."
        }
      },
      "required": [
        "roomId",
        "senderUid",
        "senderName",
        "isPriest",
        "text",
        "timeLabel",
        "visibility",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/abat_admins/{userId}": {
      "schema": { "$ref": "#/entities/AbatAdmin" },
      "description": "Admin role allowlist documents for privileged ministry operators."
    },
    "/abat_users/{userId}": {
      "schema": { "$ref": "#/entities/AbatUser" },
      "description": "User profile and PII documents isolated per owner and administrator."
    },
    "/abat_rooms/{roomId}": {
      "schema": { "$ref": "#/entities/AbatRoom" },
      "description": "Assembly hall and confession meeting room metadata synchronized with LiveKit."
    },
    "/abat_schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/AbatSchedule" },
      "description": "Confession booking schedules and spiritual appointment slots."
    },
    "/abat_announcements/{announcementId}": {
      "schema": { "$ref": "#/entities/AbatAnnouncement" },
      "description": "Community announcements published by priests and administrators."
    },
    "/abat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/AbatMessage" },
      "description": "Real-time text chat messages associated with assembly and confession rooms."
    }
  }
}
